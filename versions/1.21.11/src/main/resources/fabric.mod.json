{
	"schemaVersion": 1,
	"id": "bodycount",
	"version": "${version}",
	"name": "BodyCount",
	"description": "Adds a fourth tab to the statistics screen: per-player totem pops, kills and deaths, chat based kill/totem pairs, a server profile manager and a settings screen with themes. Client side only: it counts the events your client can see.",
	"authors": ["ggglobus228"],
	"license": "MIT",
	"icon": "assets/bodycount/icon.png",
	"environment": "client",
	"contact": {
		"sources": "https://github.com/ggglobus28-afk/player-stats",
		"issues": "https://github.com/ggglobus28-afk/player-stats/issues"
	},
	"entrypoints": {
		"client": ["com.bodycount.BodyCountMod"],
		"modmenu": ["com.bodycount.compat.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "bodycount.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": ">=1.21.11 <26.1",
		"java": ">=21"
	},
	"breaks": {
		"playerstats": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"badges": ["client"]
		}
	}
}